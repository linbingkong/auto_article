[Unit]
Description=WeChat Auto Article Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wechat-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wechat-agent/.venv/bin/wechat-agent schedule
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
