# ============================================================
# 密钥配置模板：复制为 .env 并填入真实值（.env 不要提交到 git）
# ============================================================

# 公众号（必填，用于发布）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# LLM（必填，用于写作）
DEEPSEEK_API_KEY=
# 若用本地模型，base_url 指向本地即可，api_key 可随意填

# 文生图（可选，用 pillow 合成时不需要）
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 榜单外网页/新闻搜索（可选，Tavily）
TAVILY_API_KEY=

# 微信支付 API v3 Key（启用 Native 在线支付时必填，严格 32 字节）
WECHAT_PAY_API_V3_KEY=

# 通知 webhook（可选）
NOTIFY_WEBHOOK_URL=

# Web 管理台认证（生产必填，至少 32 位随机字符串）
JWT_SECRET=
# 公开注册手机号精确匹配 HMAC 密钥（生产必填，至少 32 位且与 JWT_SECRET 不同）
PHONE_HASH_SECRET=
# 用户个人 LLM/搜索/图片配置的加密密钥（生产必填，至少 32 位）
USER_CONFIG_SECRET=
# 兼容旧自动化调用，可选；普通网页登录不需要
WEB_ADMIN_TOKEN=
# 首次启动管理员密码；创建管理员后应删除此项并立即修改密码
INITIAL_ADMIN_PASSWORD=

# 生产数据库（不配置或设为 sqlite 时继续使用 output/*.db）
DATABASE_BACKEND=sqlite
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=wechat_agent
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT=10
# 公网数据库强烈建议配置服务商 CA 文件并启用 TLS
MYSQL_SSL_CA=
